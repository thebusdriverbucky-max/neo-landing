# Database
# Pooled/runtime connection.
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
# Direct/unpooled connection to the same database, branch, and schema. Prisma
# uses this URL for migrations; this is not a second database.
DIRECT_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Admin
# REQUIRED: admin panel will not work without these two variables.
ADMIN_PASSWORD="your-secure-password"
# REQUIRED: used to sign admin session tokens. Generate with: openssl rand -base64 32
JWT_SECRET="your-jwt-secret"

# OPTIONAL — built-in server-side Cloudinary image uploader
# Configure all three values together. Without them, admins can paste hosted
# image URLs in every image editor. Never expose the API secret with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# License
LICENSE_KEY="your-license-key"
LICENSE_SERVER_URL="https://license.your-domain.com"
# Optional: shared secret for verifying license JWTs locally (avoids a network
# call per request). If omitted, every request is validated against the license server.
LICENSE_SERVER_SECRET="your-license-server-secret"
LICENSE_PRODUCT="neo-landing"

# Next
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional booking email notifications. Configure all three values together.
ADMIN_EMAIL="owner@example.com"
RESEND_API_KEY="re_..."
EMAIL_FROM="Website <bookings@example.com>"

# Optional distributed API rate limiting. Configure both or neither.
# Without Upstash, protect /api/admin/login and /api/booking with hosting WAF rules.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
